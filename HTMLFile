<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>32nd Street Site Documentation Viewer</title>
    <style>
      :root {
        --bg: #f4f4f4;
        --panel: #ffffff;
        --line: #d0d0d0;
        --text: #1f1f1f;
        --muted: #666666;
        --accent: #1f4e79;
        --accent-soft: #eaf1f8;
        --header: #2d2d2d;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.45;
      }
      .page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 24px;
      }
      .masthead {
        background: var(--panel);
        border: 1px solid var(--line);
        padding: 20px 24px;
        display: grid;
        grid-template-columns: 240px 1fr 240px;
        gap: 20px;
        align-items: start;
      }
      .company-block img {
        max-width: 180px;
        height: auto;
        display: block;
        margin-bottom: 12px;
      }
      .small {
        font-size: 13px;
        color: var(--muted);
      }
      .project-block {
        text-align: center;
      }
      .project-block h1 {
        margin: 0 0 6px;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 1.5px;
        color: var(--header);
        text-transform: uppercase;
      }
      .project-block h2 {
        margin: 0 0 6px;
        font-size: 30px;
        color: var(--accent);
      }
      .project-block h3 {
        margin: 0 0 6px;
        font-size: 22px;
        font-weight: 700;
        color: var(--header);
      }
      .client-block {
        text-align: right;
        font-size: 14px;
      }
      .summary,
      .toc {
        margin-top: 18px;
        background: var(--panel);
        border: 1px solid var(--line);
        padding: 18px 24px;
      }
      .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-top: 12px;
      }
      .summary-card {
        border: 1px solid var(--line);
        padding: 12px;
        background: #fafafa;
      }
      .summary-card .label {
        font-size: 12px;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }
      .summary-card .value {
        margin-top: 4px;
        font-weight: 700;
      }
      .toc h4,
      .section-list h4 {
        margin: 0 0 12px;
        font-size: 16px;
        text-transform: uppercase;
        color: var(--header);
        letter-spacing: 0.6px;
      }
      .toc-links {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }
      .toc-links a {
        color: var(--accent);
        text-decoration: none;
        padding: 8px 12px;
        border: 1px solid var(--line);
        background: #fafafa;
        font-size: 14px;
      }
      .section-list {
        margin-top: 18px;
        display: grid;
        gap: 16px;
      }
      details.street {
        background: var(--panel);
        border: 1px solid var(--line);
      }
      details.street[open] {
        border-color: #aebdcb;
      }
      details.street summary {
        cursor: pointer;
        list-style: none;
        padding: 16px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        font-size: 22px;
        font-weight: 700;
        color: var(--header);
        border-left: 6px solid var(--accent);
        background: #fcfcfc;
      }
      details.street summary::-webkit-details-marker {
        display: none;
      }
      .summary-right {
        font-size: 13px;
        font-weight: 400;
        color: var(--muted);
        white-space: nowrap;
      }
      .street-body {
        padding: 20px;
        border-top: 1px solid var(--line);
      }
      .street-meta {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 18px;
      }
      .meta-box {
        padding: 12px;
        background: var(--accent-soft);
        border: 1px solid #c9d7e6;
        overflow-wrap: anywhere;
      }
      .meta-box .label {
        font-size: 12px;
        color: var(--muted);
        text-transform: uppercase;
      }
      .meta-box .value {
        margin-top: 4px;
        font-size: 15px;
        font-weight: 700;
      }
      .views {
        display: grid;
        gap: 14px;
      }
      .view-card {
        border: 1px solid var(--line);
        background: #fafafa;
      }
      .view-header {
        padding: 12px 14px;
        border-bottom: 1px solid var(--line);
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: center;
        background: var(--accent);
      }
      .view-title {
        font-size: 18px;
        font-weight: 700;
        color: #ffffff;
      }
      .view-tag {
        font-size: 12px;
        color: var(--accent);
        background: #eaf1f8;
        border: 1px solid #c9d7e6;
        padding: 6px 10px;
        display: inline-block;
        overflow-wrap: anywhere;
      }
      .view-content {
        padding: 14px;
        display: grid;
        grid-template-columns: 1fr 360px;
        gap: 18px;
        align-items: start;
      }
      .thumb {
        grid-column: 2;
        grid-row: 1;
      }
      .view-details {
        grid-column: 1;
        grid-row: 1;
        display: grid;
        gap: 8px;
      }
      .thumb video {
        width: 100%;
        display: block;
        border: 1px solid var(--line);
        background: #000;
      }
      .detail-row {
        display: grid;
        grid-template-columns: 180px 1fr;
        gap: 10px;
        padding-bottom: 6px;
        border-bottom: 1px dotted #d7d7d7;
        font-size: 14px;
      }
      .detail-row strong {
        color: var(--header);
      }
      .footer {
        margin: 24px 0 40px;
        font-size: 12px;
        color: var(--muted);
        text-align: center;
      }
      @media (max-width: 960px) {
        .masthead,
        .street-meta,
        .summary-grid,
        .view-content {
          grid-template-columns: 1fr;
        }
        .client-block,
        .project-block {
          text-align: left;
        }
        .detail-row {
          grid-template-columns: 1fr;
        }
        .thumb,
        .view-details {
          grid-column: auto;
          grid-row: auto;
        }
        .view-header {
          display: block;
        }
        .view-tag {
          display: inline-block;
        }
        .summary-right {
          white-space: normal;
        }
      }
    </style>
